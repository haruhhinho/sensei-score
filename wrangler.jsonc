{
  // Cloudflare Workers の設定（Workers で公開する場合に使われます）
  // "name" は Cloudflare 上の Worker の名前と同じにしてください。
  "name": "sensei-score",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 管理画面で入れた変数を、公開のたびに消さないようにする
  "keep_vars": true,
  // 試し版（プレビュー）のURLは作らない
  "preview_urls": false
}
